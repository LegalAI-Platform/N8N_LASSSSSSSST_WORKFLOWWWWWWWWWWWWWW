    {
      "parameters": {
        "jsCode": "const s=JSON.parse(JSON.stringify($('Verify Draft Created').item.json));\nconst status=Number($json.statusCode||0);\nconst body=$json.body;\nconst sent=status>=200&&status<300&&!$json.error&&!(body&&typeof body==='object'&&(body.error||body.code||body.success===false));\ns.rankmath={target:95,score:null,metadata_saved:sent,metadata_verified:false,save_http_status:status||null,status:'NOT_MEASURED',note:'لم تُحسب درجة Rank Math بعد داخل محرر WordPress.'};\nif(!sent)s.rankmath.note='تعذر تأكيد حفظ حقول Rank Math. HTTP '+(status||'unavailable')+'. '+String($json.error?.message||$json.error||body?.message||'').slice(0,240);\ndelete s.rankmath_payload;\nreturn [{json:s}];"
