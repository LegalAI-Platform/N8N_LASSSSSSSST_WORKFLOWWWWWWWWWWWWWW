    {
      "parameters": {
        "jsCode": "\nconst s=JSON.parse(JSON.stringify($('Check Draft Idempotency').itemMatching(0).json));\nif(s.decision!=='approve'||!s.passed)throw new Error('Latest approval required');\nconst items=$input.all();if(items.length!==4)throw new Error('Four media uploads required');\nconst media=items.map((x,i)=>{\n const image=$('Prepare Approved Image').itemMatching(i).json.image,p=x.json;\n if(!Number.isInteger(p.id)||p.id<=0||typeof p.source_url!=='string'||!p.source_url.startsWith(s.settings.site_url+'/'))throw new Error('Media upload not confirmed');\n return {...image,id:p.id,url:p.source_url};\n});\nif(new Set(media.map(m=>m.role)).size!==4)throw new Error('Duplicate media role');\nconst featured=media.find(m=>m.role==='featured');if(!featured)throw new Error('Missing featured image');\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nlet content=s.article.content_html;\nfor(const im of media.filter(x=>x.role!=='featured')){\n const marker='<!-- ARTICLE_IMAGE_'+im.index+' -->';\n if(!content.includes(marker))throw new Error('Missing inline image slot '+im.index);\n content=content.replace(marker,'<figure class=\"wp-block-image size-full\"><img src=\"'+esc(im.url)+'\" alt=\"'+esc(im.alt_text)+'\" width=\"1200\" height=\"630\" class=\"wp-image-'+im.id+'\" loading=\"lazy\" decoding=\"async\"></figure>');\n}\nif(/ARTICLE_IMAGE_/.test(content)||(content.match(/<img\\b/g)||[]).length!==3)throw new Error('Invalid inline image count');\nconst a=s.article;\nconst tagNames=(a.existing_tag_ids||[]).map(id=>s.taxonomy.tags.find(t=>Number(t.id)===Number(id))?.name);\nif(tagNames.some(x=>!x))throw new Error('Unknown tag ID');\ns.wp_media_id=featured.id;s.wp_images=media;s.article.content_html=content;\ns.wp_payload={status:'draft',title:a.title,slug:a.slug,post_content:s.marker+'\\n'+content,excerpt:a.meta_description,rankmath_title:a.seo_title,rankmath_description:a.meta_description,categories:[Number(a.category_id)],tags:[...new Set(tagNames)]};\nreturn [{json:s,pairedItem:{item:0}}];"
      },
