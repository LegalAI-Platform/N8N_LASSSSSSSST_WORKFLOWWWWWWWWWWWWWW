    {
      "parameters": {
        "jsCode": "const s=JSON.parse(JSON.stringify($('Keep Rank Math Save Result').item.json));\nconst status=Number($json.statusCode||0);\nconst p=$json.body;\nconst ok=status>=200&&status<300&&p&&typeof p==='object'&&Number(p.post_id)===Number(s.wp_post_id)&&!p.error;\ns.rankmath.metadata_verified=false;\ns.rankmath.target_verified=false;\nif(ok){\n const norm=v=>String(v??'').trim();\n const expected={title:s.article.seo_title,description:s.article.meta_description,focus_keyword:s.article.keyword};\n const mismatches=Object.keys(expected).filter(k=>!norm(expected[k])||norm(p[k])!==norm(expected[k]));\n s.rankmath.metadata_verified=mismatches.length===0;\n s.rankmath.metadata_mismatches=mismatches;\n const raw=p.seo_score;\n const score=(typeof raw==='number'||(typeof raw==='string'&&raw.trim()!==''))?Number(raw):NaN;\n if(Number.isFinite(score)&&score>=0&&score<=100){\n  s.rankmath.score=score;s.rankmath.status='STORED_SCORE';\n  s.rankmath.note='الدرجة المحفوظة في Rank Math: '+score+'/100؛ ليست إعادة حساب جديدة، وقد تختلف عن درجة المحرر. الهدف 95/100 غير مُتحقق بعد.';\n }else{\n  s.rankmath.score=null;s.rankmath.status='NOT_MEASURED';\n  s.rankmath.note='تمت قراءة حقول Rank Math لكن لا توجد درجة محفوظة صالحة؛ افتح محرر WordPress لقياس الدرجة الفعلية.';\n }\n if(mismatches.length)s.rankmath.note+=' حقول SEO غير مؤكدة أو غير مطابقة: '+mismatches.join(', ')+'.';\n}else{\n s.rankmath.score=null;s.rankmath.status='READ_FAILED';\n s.rankmath.note=status===403?'رفضت أداة Rank Math قراءة بيانات هذه المسودة (403). يلزم فحص صلاحيات الأداة دون تغييرها تلقائياً.':'تعذر التحقق من بيانات Rank Math للمسودة المطلوبة. HTTP '+(status||'unavailable')+'.';\n}\nif(!s.rankmath.metadata_saved)s.rankmath.note+=' طلب حفظ حقول SEO لم يُؤكد نجاحه؛ راجع نتيجة القراءة.';\n\nif(s.seo_preflight?.stored_slug_verified===false)s.rankmath.note+=' تنبيه: الرابط المحفوظ لا يتضمن الكلمة المفتاحية حرفيًا؛ راجع slug في WordPress.';\ns.rankmath_warning='Rank Math: '+s.rankmath.note;\nif(s.seo_preflight)s.rankmath_warning+='\\nفحص المحتوى (ليس درجة Rank Math): كثافة الكلمة '+s.seo_preflight.approx_keyword_density+'%، عددها '+s.seo_preflight.exact_keyword_occurrences+'، رقم بعنوان SEO '+(s.seo_preflight.seo_title_has_number?'نعم':'لا')+'، تطابق الرابط المحفوظ '+(s.seo_preflight.stored_slug_verified?'نعم':'غير مؤكد')+'.';\n\nreturn [{json:s}];"
      },
