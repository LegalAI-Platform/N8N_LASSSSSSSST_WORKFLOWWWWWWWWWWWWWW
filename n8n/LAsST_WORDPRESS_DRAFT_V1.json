      "parameters": {
        "jsCode": "\nconst s=$json;\nif(s.decision!=='approve'||!s.passed)throw new Error('Latest human approval required');\nif(!Array.isArray(s.images)||s.images.length!==4)throw new Error('Approved package must have four images');\nconst out=[];\nfor(const im of s.images){\n im.file_name=String(s.topic.topic_id).replace(/[^A-Za-z0-9_-]/g,'-')+'-'+s.reservation_token+'-v'+s.revision+'-'+im.role+'.webp';\n const image=await this.helpers.prepareBinaryData(Buffer.from(im.base64,'base64'),im.file_name,'image/webp');\n const {base64,...metadata}=im;\n out.push({json:{settings:s.settings,article:{title:s.article.title},image:metadata},binary:{image},pairedItem:{item:0}});\n}\nreturn out;"
      },
