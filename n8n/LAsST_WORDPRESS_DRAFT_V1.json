    {
      "parameters": {
        "jsCode": "const s=JSON.parse(JSON.stringify($('Normalize WordPress Input').item.json));const list=$json.body;if(!Array.isArray(list))throw new Error('Unexpected WordPress lookup response');\nconst marker='<!-- n8n-legal-topic:'+s.topic.topic_id+' -->';s.marker=marker;\nif(list.length>1)throw new Error('Ambiguous WordPress slug: multiple posts require reconciliation');\nif(list.length){const p=list[0];if(p.status!=='draft'||!String(p.content?.raw||p.content?.rendered||'').includes(marker))throw new Error('Slug already belongs to another article or a published post; manual check required.');if(!Number.isInteger(p.featured_media)||p.featured_media<=0)throw new Error('Existing draft needs image recovery; do not create a duplicate.');s.wp_post_id=p.id;s.wp_url=s.settings.site_url+'/?p='+p.id+'&preview=true';s.already_created=true;}\nelse s.already_created=false;return [{json:s}];"
      },
