        "jsCode": "const s=JSON.parse(JSON.stringify($('Validate Created Draft').item.json));\nif(Number($json.id)!==s.wp_post_id||$json.status!=='draft'||Number($json.featured_media)!==s.wp_media_id)throw new Error('WordPress did not confirm draft and approved featured image');\nlet storedSlug='';try{storedSlug=decodeURIComponent(String($json.slug||'')).normalize('NFC');}catch(e){}\ns.seo_preflight={...(s.seo_preflight||{}),stored_slug:storedSlug,stored_slug_verified:storedSlug.replace(/-/g,' ').replace(/\\s+/g,' ').includes(String(s.article.keyword).normalize('NFC').replace(/\\s+/g,' ').trim())};\nif(!s.seo_preflight.stored_slug_verified)s.review_warning_text=(s.review_warning_text||'')+'\\nتنبيه: WordPress لم يؤكد تطابق الكلمة المفتاحية في الرابط المحفوظ؛ راجع slug في المحرر.';\ns.wp_url=s.settings.site_url+'/?p='+s.wp_post_id+'&preview=true';s.rankmath_payload={objectType:'post',objectID:Number(s.wp_post_id),meta:{rank_math_title:s.article.seo_title,rank_math_description:s.article.meta_description,rank_math_focus_keyword:s.article.keyword}};\nreturn [{json:s}];"
      },
