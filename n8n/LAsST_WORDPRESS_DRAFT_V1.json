    {
      "parameters": {
        "jsCode": "const s=JSON.parse(JSON.stringify($json));if(!s.wp_post_id||!s.wp_url)throw new Error('Missing confirmed draft');\nif(!s.approved.some(a=>a.topic_id===s.topic.topic_id)){s.approved_count++;s.approved.push({topic_id:s.topic.topic_id,title:s.article.title,url:s.wp_url});}\ns.reason='Approved version '+s.review_token;\nconst draftMessage=[\n'تم إنشاء مسودة WordPress بعد الموافقة.',\nString(s.article.title),\n'رابط المعاينة (يتطلب تسجيل دخول):',\ns.wp_url,\n'رابط التحرير:',\ns.settings.wp_admin_url+'/post.php?post='+s.wp_post_id+'&action=edit',\ns.rankmath_warning||'Rank Math: يلزم فتح المسودة للتحقق من الدرجة الفعلية؛ الهدف 95/100.',\ns.review_warning?'⚠️ ملاحظات المراجعة محفوظة في تقرير المقال؛ لم تمنع إنشاء المسودة.':'',\n'الدفعة: '+s.batch_id+' — تم تأكيد مسودة هذا المقال'\n].filter(Boolean).join('\\n');\ns.draft_notification_html=draftMessage.slice(0,3800).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nreturn [{json:s}];"
      },
