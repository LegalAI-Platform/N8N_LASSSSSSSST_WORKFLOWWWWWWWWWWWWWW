      "typeVersion": 2,
      "position": [
        1720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function parse(v){if(typeof v==='object'&&v)return v;return JSON.parse(String(v||'').trim().replace(/^```(?:json)?\\s*/,'').replace(/\\s*```$/,''));}\nconst s=JSON.parse(JSON.stringify($('Compact Research Evidence').item.json));const r=parse($json.output);s.research=r;s.reason=r.reason||'';s.eligible=r.eligible!==false;return [{json:s}];"
      }
    }
